# --- Model access: pick ONE of the two blocks ---

# Option A (recommended): Vertex AI - bills your GCP project, no API key.
# Needs: gcloud auth application-default login, and the aiplatform API enabled.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global

# Option B: AI Studio key (free tier: https://aistudio.google.com).
# Mind the free-tier daily caps - fine for a smoke test, not for the
# 50k-row reconciliation runs.
# GOOGLE_GENAI_USE_VERTEXAI=false
# GOOGLE_API_KEY=your-key-here

# Model + pricing (USD per 1M tokens, Vertex list prices for gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash
PRICE_INPUT_PER_M=1.50
PRICE_OUTPUT_PER_M=7.50

# Storage backend: sqlite (local dev) | firestore (cloud)
DUKA_STORE=sqlite
DUKA_DB=data/duka.db
# FIRESTORE_DATABASE=(default)      # used when DUKA_STORE=firestore

# local | cloud (cloud calls the deployed Agent Engine)
RUN_MODE=local
# AGENT_ENGINE_ID=your-engine-id    # required when RUN_MODE=cloud
