# --- Model access: Vertex AI is the Duka release contract ---
# Bills your GCP project and uses ADC locally; no API key is stored here.
# Needs: gcloud auth application-default login, and the aiplatform API enabled.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=agent-platform-503913
GOOGLE_CLOUD_LOCATION=global

# Model is an explicit compatibility contract. Do not change it to work around
# location or quota errors.
GEMINI_MODEL=gemini-3.7-flash
# Pricing (USD per 1M tokens): 3.7-flash INTRO rates, valid through
# 2026-12-31; standard rates from 2027-01-01 are 1.50 / 7.50.
PRICE_INPUT_PER_M=0.75
PRICE_OUTPUT_PER_M=3.75

# Storage backend: sqlite (local dev) | firestore (cloud)
DUKA_ENV=local
DUKA_STORE=sqlite
DUKA_DB=data/duka.db
# FIRESTORE_DATABASE=(default)      # used when DUKA_STORE=firestore

# Event bus: local | pubsub
DUKA_BUS=local
# PUBSUB_TOPIC_PREFIX=duka-dev-

# Cloud mode (DUKA_ENV=dev|prod): the same context resource backs managed ADK
# Sessions and Memory Bank. Use the short reasoning-engine ID or full name.
# AGENT_CONTEXT_ID=your-context-resource-id
AGENT_CONTEXT_LOCATION=global
DUKA_SESSION_TTL=7776000s

# Generate distinct high-entropy values and store cloud values in Secret
# Manager. Never commit real values.
# DUKA_USER_KEY_SECRET=replace-with-stable-hmac-secret
# DUKA_OWNER_PASSWORD=replace-with-demo-owner-password
# DUKA_SESSION_SECRET=replace-with-cookie-signing-secret
# DUKA_CHANNEL_KEY=replace-with-inbound-bridge-secret

# Judge-facing demo (cloud only): grant the owner session on arrival instead of
# behind a password, so judges never see a login form. Owner routes still
# require an owner session and customer scoping is unchanged. Defaults off;
# only sound because every demo record is synthetic.
# DUKA_DEMO_OPEN_ACCESS=true

# Deployment metadata
RELEASE_SHA=local

# Cloud Run exports sampled traces directly to Google Cloud's Telemetry OTLP
# endpoint using its runtime service account. Local mode leaves tracing inert.
DUKA_TRACE_ENABLED=false
DUKA_TRACE_SAMPLE_RATE=1.0

# Whole-request and per-instance burst ceilings. Cloud Run IAM, max instances,
# and concurrency remain the outer controls; these protect parsing/model work.
DUKA_MAX_REQUEST_BYTES=8500000
DUKA_RATE_LIMIT_AUTH_LOGIN=10
DUKA_RATE_LIMIT_CHAT=60
DUKA_RATE_LIMIT_INBOUND=120
DUKA_RATE_LIMIT_PUBSUB_PUSH=240
